# Novu Self-Hosted Configuration
# Copy this file to .env.novu and fill in your values

# ============================================
# Environment
# ============================================
NODE_ENV=production
REACT_APP_ENVIRONMENT=production

# ============================================
# URLs
# ============================================
FRONT_BASE_URL=http://192.168.1.78:4200
REACT_APP_API_URL=http://192.168.1.78:3000
REACT_APP_WS_URL=http://192.168.1.78:3002

# ============================================
# Security - IMPORTANT: Change these values!
# ============================================
# Generate with: openssl rand -base64 32
NOVU_JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
# Must be exactly 32 characters
NOVU_ENCRYPTION_KEY=your-32-char-encryption-key-here

# ============================================
# MongoDB
# ============================================
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=changeme-in-production
MONGO_MAX_POOL_SIZE=10
MONGO_MIN_POOL_SIZE=2

# ============================================
# Redis
# ============================================
REDIS_PASSWORD=

# ============================================
# S3 Storage (LocalStack for development)
# ============================================
S3_LOCAL_STACK=http://localstack:4566
S3_BUCKET_NAME=novu-local
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# ============================================
# API Rate Limiting
# ============================================
API_RATE_LIMIT_MAXIMUM=500
API_RATE_LIMIT_DURATION=60

# ============================================
# User Registration
# ============================================
DISABLE_USER_REGISTRATION=false

# ============================================
# Monitoring (Optional)
# ============================================
# New Relic
NEW_RELIC_APP_NAME=
NEW_RELIC_LICENSE_KEY=

# Sentry
SENTRY_DSN=

# ============================================
# Application Integration
# ============================================
# Your backend API URL
BACKEND_API_URL=http://192.168.1.78:8000

# Your frontend URL
FRONTEND_URL=http://192.168.1.78:3001
